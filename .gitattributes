# Normalize line endings in the repository to LF.
* text=auto eol=lf

# Shell scripts must keep LF or they break on Linux/macOS.
*.sh   text eol=lf
gradlew text eol=lf

# Windows batch files want CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never touch.
*.jar  binary
*.png  binary
*.gif  binary
*.ogg  binary
*.zip  binary

# Java sources: diff as text.
*.java text diff=java
